# Sao chép thành .env và điền giá trị thật. KHÔNG commit .env. Trong CI dùng GitHub Secrets.

# Cloudflare R2 (S3 API). Endpoint tự suy ra từ R2_ACCOUNT_ID.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# NASA Earthdata. AppEEARS cần tên đăng nhập + mật khẩu (API login của AppEEARS).
# EARTHDATA_TOKEN chỉ dùng để tải tile GFSAD (chưa kiểm chứng; nếu không có thì dùng tên đăng nhập + mật khẩu).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# PostgreSQL của app: postgresql://user:password@host:5432/dbname?sslmode=require
# DATABASE_URL: kết nối TRỰC TIẾP (dùng cho migration và load_postgres.py).
# Với Neon: lấy từ DATABASE_URL_UNPOOLED, KHÔNG dùng chuỗi có "-pooler" (PgBouncer ở chế độ transaction
# có thể làm mất SET search_path giữa các câu lệnh).
DATABASE_URL=
# DATABASE_URL_POOLED: chuỗi qua pooler, dành cho app có nhiều kết nối ngắn (không dùng cho load_postgres.py).
DATABASE_URL_POOLED=
